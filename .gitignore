# Site-local configuration — every machine has its own. Never commit.
paddock.toml

# Which of .claude/hooks/ you have switched on, and any other per-machine
# Claude Code settings. The scripts are tracked; whether they run here is not.
# See .claude/hooks/README.md.
.claude/settings.local.json

# Symlink farm pointing at this machine's vendor clones.
external/

# Run artifacts (predictions, frames, videos) live outside the repo.
# Only results/ (metrics + provenance) is tracked.
runs/
paddock-runs/

# Dataset inventories describe *this* machine's copy, down to its mount points,
# so committing one would put a real machine root in a tracked file and fail
# tests/test_portability.py. Regenerate it instead; the tool takes a minute.
COMMA2K19_METADATA.md

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
# nuScenes val index pickle (adapters/benchmarks/nuscenes) defaults here.
.cache/
.mypy_cache/
# Jupyter autosaves beside the notebook, outputs and all -- and saved outputs
# can hold machine paths, which tests/test_portability.py scans for.
.ipynb_checkpoints/
# The same holds for an executed copy of an analysis notebook, which is written
# beside it (`jupyter execute --output='{notebook_name}_all_executed'`).
*_executed.ipynb
dist/
build/

# Editors / OS
.vscode/
.idea/
.DS_Store
*.swp
# also as a symlink: a worktree pointing at a sibling checkout's venv
.venv

# Ignore tmp folder
.tmp
