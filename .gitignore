# Site-local configuration — every machine has its own. Never commit.
paddock.toml

# Which of .claude/hooks/ you have switched on, and any other per-machine
# Claude Code settings. The scripts are tracked; whether they run here is not.
# See .claude/hooks/README.md.
.claude/settings.local.json

# Symlink farm pointing at this machine's vendor clones.
external/

# Run artifacts (predictions, frames, videos) live outside the repo.
# Only results/ (metrics + provenance) is tracked.
runs/
paddock-runs/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
# nuScenes val index pickle (adapters/benchmarks/nuscenes) defaults here.
.cache/
.mypy_cache/
dist/
build/

# Editors / OS
.vscode/
.idea/
.DS_Store
*.swp
# also as a symlink: a worktree pointing at a sibling checkout's venv
.venv
