+++ b/navsim_v2/navsim/agents/drive_jepa_perception_based/bevformer/msda_compat.py
@@ -0,0 +1,28 @@
+import os
+
+import torch
+
+# mmcv-full's `_ext` ships SASS for sm_50..sm_86 and embeds no PTX, so there is
+# no JIT path onto newer GPUs. Anything above this launches with
+# "CUDA error: no kernel image is available for execution on the device".
+_MAX_COMPILED_CAPABILITY = (8, 6)
+
+
+def use_compiled_msda(value: torch.Tensor) -> bool:
+    """Whether the compiled multi-scale deformable attention kernel can run here.
+
+    The pure-PyTorch implementation (`multi_scale_deformable_attn_pytorch`) is
+    numerically equivalent and device-agnostic, just slower, so it is the safe
+    choice whenever the compiled kernel is unusable.
+
+    Override with DRIVE_JEPA_MSDA=compiled or DRIVE_JEPA_MSDA=pytorch.
+    """
+    mode = os.environ.get("DRIVE_JEPA_MSDA", "auto")
+    if mode == "compiled":
+        return True
+    if mode == "pytorch":
+        return False
+
+    if not (torch.cuda.is_available() and value.is_cuda):
+        return False
+    return torch.cuda.get_device_capability(value.device) <= _MAX_COMPILED_CAPABILITY
