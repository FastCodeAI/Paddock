+def current_actor_state(actors: list[ActorTrajectory], timestamp_us: int) -> list[dict]:
+    """Current-step-only actor state for a privileged ground-truth model
+    (e.g. an expert planner): current world pose and a strictly backward-
+    looking finite-difference velocity, never a scripted future path.
+
+    Unlike `get_velocity_at_timestamp` above (which can difference forward
+    to the *next* logged sample when the nearest sample precedes
+    `timestamp_us`), this only ever reads samples with
+    timestamp <= timestamp_us, so it cannot leak anything about where the
+    actor is headed next -- the one information-rule distinction that
+    matters for a model that isn't allowed to see the future.
+    """
+    out = []
+    for actor in actors:
+        past = np.nonzero(actor.timestamps <= timestamp_us)[0]
+        idx = int(past[-1]) if len(past) else 0
+        pose = actor.poses[idx]
+        x, y = float(pose[0, 3]), float(pose[1, 3])
+        # actor poses use the y-forward/x-right convention (see
+        # get_polygons_from_poses3d below); the world heading of the
+        # forward direction is convention-independent once extracted.
+        forward = pose[:2, 1]
+        heading = float(np.arctan2(forward[1], forward[0]))
+
+        if idx > 0:
+            prev_pose = actor.poses[idx - 1]
+            dt = (actor.timestamps[idx] - actor.timestamps[idx - 1]).astype(np.float64) / 1e6
+            vx = (pose[0, 3] - prev_pose[0, 3]) / dt if dt > 0 else 0.0
+            vy = (pose[1, 3] - prev_pose[1, 3]) / dt if dt > 0 else 0.0
+        else:
+            vx = vy = 0.0  # no prior sample yet -- first step of the episode
+
+        out.append({
+            "uuid": actor.uuid,
+            "cls_name": actor.cls_name,
+            "length": float(actor.dims[1]),
+            "width": float(actor.dims[0]),
+            "x": x, "y": y, "heading": heading,
+            "vx": float(vx), "vy": float(vy),
+        })
+    return out
+
