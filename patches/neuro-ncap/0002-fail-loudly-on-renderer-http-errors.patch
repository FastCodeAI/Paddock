Subject: [PATCH 2/2] fail loudly when a renderer call returns an error

Correctness fix, not a convenience. `APIClient` returned the response without
checking status, so endpoints whose result is never read back -- `/update_actors`
above all -- could fail with nothing downstream noticing.

When that call fails, the renderer keeps the actor on its original logged
trajectory while the simulator moves it onto the staged collision course. The
model is then shown a scene that never contains the vehicle it is being scored
against colliding with. The run completes and reports plausible NCAP scores that
mean nothing at all.

This is not hypothetical: it produced a full set of results here before it was
found, which is why one output directory is named
INVALID_runs1_actor_not_rendered. A silent failure that yields believable
numbers is far more expensive than a crash.

Should go upstream.

diff --git a/neuro_ncap/utils/web.py b/neuro_ncap/utils/web.py
index 6044abf..65eedfd 100644
--- a/neuro_ncap/utils/web.py
+++ b/neuro_ncap/utils/web.py
@@ -14,11 +14,32 @@ class APIClient:
 
     async def _get_async(self, endpoint: str) -> httpx.Response:
         async with httpx.AsyncClient(base_url=self.base_url) as client:
-            return await client.get(endpoint, timeout=None)
+            response = await client.get(endpoint, timeout=None)
+        _raise_for_status(self.base_url, endpoint, response)
+        return response
 
     async def _post_async(self, endpoint: str, json: Any | None = None) -> httpx.Response:
         async with httpx.AsyncClient(base_url=self.base_url) as client:
-            return await client.post(endpoint, json=json, timeout=None)
+            response = await client.post(endpoint, json=json, timeout=None)
+        _raise_for_status(self.base_url, endpoint, response)
+        return response
+
+
+def _raise_for_status(base_url: str, endpoint: str, response: httpx.Response) -> None:
+    """Fail loudly on an error response.
+
+    Endpoints whose result is not read back -- /update_actors above all -- can
+    fail without anything downstream noticing. When that one fails, the renderer
+    keeps the actor on its original logged trajectory while the simulator moves
+    it to the staged collision course, so the models are shown a scene that
+    never contains the vehicle they are being scored on colliding with. The run
+    completes and produces plausible scores that mean nothing.
+    """
+    if response.is_success:
+        return
+    raise RuntimeError(
+        f"{base_url}{endpoint} returned HTTP {response.status_code}: {response.text[:500]}"
+    )
 
 
 async def wait_until_alive(url: str, max_time: float = 300, print_interval: float = 5) -> None:
