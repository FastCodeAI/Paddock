# ---------------------------------------------------------------------------
# Paddock site configuration.
#
# Copy this file to `paddock.toml` and edit the paths for YOUR machine.
# `paddock.toml` is gitignored: it is the only file that knows where anything
# lives, which is what lets the rest of the repo be identical at every site.
#
#   cp paddock.toml.example paddock.toml
#   $EDITOR paddock.toml
#   paddock doctor
#
# Set PADDOCK_CONFIG=/path/to/other.toml to use a different file, so one
# checkout can serve several layouts (a laptop and a compute box, say).
#
# Anything you don't have yet, leave commented out. `paddock doctor` reports
# what is missing and what that blocks; it is not an error to be incomplete.
# ---------------------------------------------------------------------------

# Free-form label for this machine. Recorded in every run.json so results from
# different sites stay distinguishable in one shared history. Keep it stable.
site = "CHANGEME-org-hostname"

[roots]
# Where vendor clones (openpilot, alpamayo1.5, Drive-JEPA, ...) live, or should
# be cloned to. `paddock setup` adopts clones already here rather than re-cloning.
repos = "/path/to/your/repos"

# Where run artifacts go: predictions, frames, videos. These get large — 14 GB
# for a modest neuroNCAP sweep — so point this at a disk with room. NOT tracked
# by git; only the small metrics under results/ are.
runs = "/path/to/paddock-runs"

# Model checkpoints. Shared across models where possible.
weights = "/path/to/weights"

# ---------------------------------------------------------------------------
# Datasets. Declare only the ones you have; see docs/data-setup.md.
# What each dataset IS (layout, required subdirs, splits) is declared once in
# the tracked datasets.yaml. This section only says WHERE it is here.
# ---------------------------------------------------------------------------

# [datasets.nuscenes]
# path = "/path/to/nuscenes"          # contains samples/, maps/, v1.0-trainval/
# version = "v1.0-trainval"           # or v1.0-mini

# [datasets.kitscenes]
# A search path, fastest tier first. Paddock resolves each scene against the
# first tier that has it, so an NVMe working set can front an HDD or NAS
# archive without duplicating the whole dataset.
# tiers = [
#   "/path/to/fast/kitscenes/data",
#   "/path/to/bulk/kitscenes/data",
# ]

# [datasets.navsim]
# path = "/path/to/navsim_workspace/dataset"   # navsim_logs/, sensor_blobs/, maps/
# exp  = "/path/to/navsim_workspace/exp"       # checkpoints + metric cache

# [datasets.comma2k19]
# raw_data/, holding Chunk_1..Chunk_10 -- NOT the sibling data/ (a HuggingFace
# demo parquet) or compression_challenge/, which are different artefacts.
# path = "/path/to/comma2k19/raw_data"

# [datasets.nuplan]
# The original nuPlan release, not NAVSIM's 2 Hz OpenScene redistribution of it.
# Two layouts are in the wild and both are searched, so point this at whichever
# directory holds maps/ and nuplan-v1.1/:
#   nuplan-v1.1/splits/<split>/*.db          (nuPlan's documented layout)
#   nuplan-v1.1/splits/data/cache/<split>/   (what the mini archive unpacks to)
# The camera blobs are a separate ~450 GB download per shard; holding the logs
# without them is a normal state that `paddock doctor` reports.
# path = "/path/to/nuplan"

# [datasets.neurad_checkpoints]
# path = "/path/to/neuroncap/checkpoints"      # per-scene NeuRAD renderers

# ---------------------------------------------------------------------------
# Benchmarks that bring their own simulator or assets say where those live here.
# What each benchmark measures is declared in its tracked benchmark.yaml; this
# section is only paths for this machine. See docs/benchmarks/<name>.md.
# ---------------------------------------------------------------------------

# [benchmarks.comma2k19]                       # docs/benchmarks/comma2k19.md
# The first three change what is measured and are hashed into the run id, so
# two runs with different values never share a config hash. Defaults shown.
# history_frames        = 160    # observations fed before the scored one
# keyframes_per_segment = 5      # scored frames per 60 s segment
# input_hz              = 20     # observation rate; only 20/n is reachable, and
#                                # PADDOCK_COMMA2K19_INPUT_HZ overrides this for
#                                # a single run (sweeping rates is the point)
# The rest change only how fast the run goes, never what it measures, so none
# of them is hashed into the run id.
# nodes                 = 4      # policy nodes scored in parallel. A comma2k19
#                                # sample is 160 frames a node must read and
#                                # colour-convert before the model sees them,
#                                # and that part is per-process CPU: profiling
#                                # put ~90% of a node's wall clock there. Raise
#                                # it to the cores you can spare; each node
#                                # still waits for the model's declared VRAM.
# frame_cache = "/dev/shm/paddock-comma2k19-$USER"
#                                # where decoded frames are staged. Each is
#                                # written once and read once, seconds apart,
#                                # by two processes on this machine -- so a
#                                # tmpfs or local NVMe belongs here if {runs}
#                                # is a network mount. Template variables and
#                                # $USER are expanded; keep the $USER, because
#                                # /dev/shm is shared by everyone on the box and
#                                # the second person to copy this line would
#                                # otherwise inherit the first one's directory
#                                # and fail mid-sweep. preflight checks that this
#                                # is writable and has room, so a wrong value
#                                # here costs a dry run rather than an hour.
#                                # Default: {runs}/comma2k19/_frames.
# keep_frames           = false  # keep the staged frames instead of releasing
#                                # them as the sweep moves on. Not hashed: it
#                                # changes nothing a model is shown. Raw frames
#                                # are ~2.4 GB per segment, so all 2033 want
#                                # about 4.9 TB -- say yes only with that free
#                                # and several runs to amortise the decode over.
#                                # Leaving it out and writing `false` mean the
#                                # same thing; every spelling of off (false, 0,
#                                # no, off) is read as off.

# [benchmarks.bench2drive]                     # CARLA closed-loop; docs/benchmarks/bench2drive.md
# python      = "/path/to/conda/envs/b2d/bin/python"  # CARLA-client env: imports carla, cv2, numpy, requests
# carla_root  = "/path/to/carla0915"                   # contains CarlaUE4.sh and PythonAPI/
# repo        = "/path/to/Bench2Drive"                 # has leaderboard/ + scenario_runner/; sha pinned in repos.yaml
# routes_file = "bench2drive220.xml"                   # under repo/leaderboard/data/ (default)
# routes_subset = "1711,1773,1790"                     # optional: pin the run to these route ids (recorded in run.json)
# per_route_timeout_s = 1800                           # default
# carla_port  = "2000"                                 # evaluator moves up to the first free port from here
# tm_port     = "8000"                                 # traffic manager port, likewise
# gpu_rank    = "0"                                    # CARLA's -graphicsadapter
# record      = "false"                                # per-tick front/BEV JPEGs + log.csv: ~40 GB per full sweep
# stop_stuck_s       = "30"                            # optional: end a route 30 s after its last 3 m of progress
# stop_expert_factor = "4"                             # optional: end a route at 4x the expert's time on it
# expert = "/path/to/expert"                           # tools.benchmarks.bench2drive.expert summarize's output
#                                                      # a route either stop_* ends is a failed drive; see the docs

# [benchmarks.alpasim]
# AlpaSim runs its services through docker compose and attaches a driver over
# gRPC; paddock supplies the driver via the bridge, so only the checkout and its
# interpreter are needed here.
# repo   = "/path/to/alpasim"
# python = "/path/to/alpasim/.venv/bin/python"
#
# Which pinned scene list to drive. See adapters/benchmarks/alpasim/scenes/:
# public_2601_first10 (the default) or public_2601_30scenes.
# scene_set = "public_2601_first10"
#
# Where AlpaSim caches the USDZ scene artifacts. Large and site-specific; an
# unset cache re-fetches every scene, which is slow rather than wrong.
# scene_cache = "/path/to/nre-artifacts"
#
# Which reconstruction replays the clip. The README carries nuRec and OmniDreams
# as separate columns because they are different reconstructions of the same
# scene -- a score from one is not a statement about the other -- so this is
# hashed into the run id and stored in run.json, and the two can never be
# averaged together by accident. Only "nurec" is wired at the pinned sha;
# anything else is refused in preflight rather than recorded as if it had run.
# renderer = "nurec"
#
# Per-frame debugging video. Upstream defaults this ON at every frame, which is
# ~180 MB per scene -- and `scene_set` is a site setting, so a site that widens
# it to all 913 public_2601 scenes gets ~160 GB per model. Off unless asked.
# video                 = false
# video_every_nth_frame = 1          # only read when video = true
#
# The wizard's two required config groups. `local` and `1gpu` are what every
# recorded run used; a site with more GPUs can raise the topology.
# deploy   = "local"
# topology = "1gpu"
#
# Backstop against a wedged container, not a performance target: about 5 min per
# scene with a 10B driver, 50 s for the constant-velocity floor.
# per_scene_timeout_s = "1800"
#
# How long the runtime waits for the driver to answer its version probe.
# Upstream defaults to 120 s; a cold 10B checkpoint read answers at ~305 s, so
# the default kills the run and blames the driver. Leave this alone unless a
# model loads slower still.
# startup_timeout_s = "900"

[gpu]
# Total VRAM paddock may assume, in GB. Used to gate model startup rather than
# discovering the hard way, several minutes into a checkpoint read, that the
# card is held by someone else.
budget_gb = 24

# Keep exactly one model resident at a time. On a shared or single-GPU box this
# is the difference between a long job and a failed one. Set false only if you
# have room for every model in `paddock run --model all` simultaneously.
serialize = true

# Benchmarks that bring their own environment and assets. Uncomment and fill in
# the ones this site can run; `paddock doctor` reports the rest as unavailable.

# [benchmarks.navsim]
# NAVSIM scores in its own devkit, in an interpreter that can import navsim and
# nuplan -- paddock supplies the model over HTTP and stores the result.
# python       = "/path/to/envs/drive-jepa/bin/python"
# devkit       = "/path/to/Drive-JEPA/navsim_v2"   # the directory holding navsim/
# metric_cache = "/path/to/exp/metric_cache_v2"    # run_metric_caching.py builds one
# nuplan       = "/path/to/nuplan-v1.1"            # optional: splits/<split>/*.db + sensor_blobs/<split>/ at 10 Hz,
#                                                  # for models needing denser input than OpenScene's 2 Hz
# split        = "navtest"
# workers      = 4
# chunk_logs   = 4        # logs per scorer invocation; 0 = one invocation (no resume)
# run_retries  = 2        # restart nodes and resume from completed chunks this many times
# nodes        = 4        # policy nodes per CPU-only model; GPU models get `gpu_nodes`
#                        # with >1 visionpilot node, also set VISIONPILOT_ORT_THREADS (e.g. "2")
#                        # under [models.visionpilot.env], or each node claims every core
# gpu_nodes    = 1        # policy nodes per GPU model; more only for a small model bound by
#                        # its per-request forward, not by memory (autoe2e: ~3 GB each).
#                        # Reaches every GPU model the run scores; capped by free VRAM / vram_gb
# keyframe_cameras = false  # dense path: a view the nuplan pull lacks (it may hold F0/L0/R0 only)
#                        # comes from OpenScene's 2 Hz keyframes; for a model whose camera
#                        # history is itself 2 Hz (autoe2e). Recorded in run.json.

# [benchmarks.navsim_v1]
# NAVSIM v1.1 PDMS on the same OpenScene data, scored by the v1 devkit that sits
# beside navsim_v2 in the Drive-JEPA clone. Same interpreter; the harness puts
# the devkit first on PYTHONPATH. A metric cache is per devkit generation: build
# this one with `python -m tools.benchmarks.navsim.build_metric_cache`; the v2
# cache does not load under v1, and preflight refuses the wrong generation.
# python       = "/path/to/envs/drive-jepa/bin/python"
# devkit       = "/path/to/Drive-JEPA/navsim_v1"   # the directory holding navsim/
# metric_cache = "/path/to/exp/metric_cache_v1"
# split        = "navtest"
# workers      = 4
# chunk_logs   = 4
# run_retries  = 2
# nodes        = 4

# [benchmarks.nuplan]
# Which nuPlan split to score. Default "mini"; the scored set is otherwise
# fixed in the adapter, because two sites must score the same anchors.
# split = "mini"

# [benchmarks.kitscenes]
# The shared keyframe list every model is scored on. It *is* the benchmark:
# two models scored on different lists are not comparable.
# sample_list = "/path/to/kitscenes_e2e_final.pkl"
#
# Height of the KITScenes reference frame (the roof pod) above the road, in
# metres. Every sensor is calibrated against that pod, so a model that
# intersects camera rays with the ground plane needs the origin dropped to road
# level -- otherwise every projected point lands behind the car. Default 2.2;
# override only if you have measured this rig.
# ground_offset_m = 2.2
#
# The route command the scored keyframe carries. KITScenes has no route
# annotation, so the default tells every model "straight". "gt" gives the
# keyframe the sample list's own driving_command, derived from the recorded
# future and standing in for the route a car's navigation knows: recorded in
# run.json, hashed into the run id, and ranked like the benchmark's other
# route-conditioned rows.
# See docs/benchmarks/kitscenes.md, "The route hint".
# command_source = "straight"   # or "gt"
#
# Which forward camera is CAM_FRONT: the ring's own, or the rig's 5856x3104
# camera_base_front_center. Recorded in run.json and hashed into the run id.
# See docs/benchmarks/kitscenes.md, "The front camera".
# front_camera = "ring"   # or "base"

# [benchmarks.neuroncap]
# Closed-loop NCAP scoring against a NeuRAD render; docs/benchmarks/neuroncap.md.
# The engine and the renderer are two different environments on purpose.
# python          = "/path/to/envs/ncap/bin/python"     # the engine's env
# repo            = "/path/to/neuro-ncap"                # has main.py; sha pinned in repos.yaml
# renderer_url    = "http://127.0.0.1:8000"              # `paddock renderer --scene <id>` serves this
# renderer_python = "/path/to/envs/neurad/bin/python"    # a *different* env from the engine
# renderer_cwd    = "/path/to/neuroncap"
# neurad_studio   = "/path/to/neurad-studio"
# checkpoints     = "/path/to/neuroncap/checkpoints"     # one per scene; also [datasets.neurad_checkpoints]
#
# A full-set sweep spans 14 scenes, and the renderer loads one scene's hash
# grids at startup and cannot switch. With this on, the harness starts and stops
# a renderer per scene, so one `paddock run` covers all 20 pairs and is rankable.
# Driven from outside it would be one run per scene, each covering 1-3 pairs and
# each correctly recorded `valid: false`. Also settable as
# PADDOCK_NCAP_MANAGE_RENDERER=true for a one-off sweep.
#
# Leave false for the single-scene workflow: `paddock renderer --scene X` in
# another shell keeps a renderer warm across several runs, which this would not.
# manage_renderer = false
#
# Per-run debugging clips. The engine writes a frame per simulation step for
# every run, which is ~83 MB per run -- about 66 GB across the full 20-pair set
# at 10 runs for four models.
# video  = "encode"   # default: one mp4 per stream per run, then drop the source
#                     #   PNGs. The raw CAM_* jpegs and trajectories/ego_poses/
#                     #   actors json stay, so any frame can be rebuilt: ~5 GB.
#                     # "keep" also keeps the PNGs (needed by
#                     #   tools/benchmarks/neuroncap/comparison_video.py).
#                     # "off" logs no frames at all -- fastest, smallest.
# ffmpeg = "/path/to/ffmpeg"   # else $PADDOCK_FFMPEG, else PATH. Without one,
#                              # frames are kept and the run is not failed.

# [benchmarks.nuscenes]
# nuScenes val open-loop planning (L2 + collision, UniAD/VAD protocol). Reads the
# v1.0-trainval tables directly -- no devkit -- using [datasets.nuscenes] above.
# The 150-scene val index is cached here; optional, defaults to <repo>/.cache/.
# index_cache = "/path/to/cache/nuscenes_val_index.pkl"

# For Openpilot only: real front-camera exposures between the scored keyframes.
# camera_history = "CAM_FRONT"
# history_image_root = "/path/to/nuscenes/with/sweeps"
# history_index_cache = "/path/to/cache/nuscenes_front_exposures.pkl"
# history_seconds = 5.0

# Configure these in the model node environment, not just the invoking shell.
# [models.openpilot.env]
# PADDOCK_OPENPILOT_CUDA_MODEL = "/path/to/driving_cuda.pkl"
# NVRTC_PATH = "/path/to/cuda_nvrtc/lib/libnvrtc.so.12"
# DEV = "CUDA"
# WARP_DEV = "CPU"
# PADDOCK_OPENPILOT_NATIVE_LONG = "0"
# PADDOCK_OPENPILOT_RESUME_S = "0"

# A pairing: settings for one model on one benchmark and nowhere else, its env
# over [models.<model>.env] and its settings over [benchmarks.<benchmark>]. This
# is how a site makes a configuration tuned on one benchmark its default there,
# without it reaching the model's other benchmarks or the benchmark's other
# models. It is recorded in run.json and hashed into the run id exactly as the
# same values set globally would be, and `paddock run` names it before it
# starts. Delete the tables to reset: the next run hashes as it did before them.
# openpilot on KITScenes, from the base front camera as comma's own would see it
# (docs/models/openpilot-guide.md). The scale, tilt and cut were chosen by
# inspecting one KITScenes scene (dbba76d9), and command_source = "gt" gives the
# scored keyframe its route, the signal Drive-JEPA's and Alpamayo's rows there
# had. A run with these tables is ranked, and the README marks it:
# [models.openpilot.benchmarks.kitscenes.env]
# PADDOCK_OPENPILOT_BACKEND = "onnx"
# PADDOCK_OPENPILOT_HEIGHT_SCALE = "1.22"
# PADDOCK_OPENPILOT_PITCH_DEG = "-1.7"
# PADDOCK_OPENPILOT_FOV_DEG = "55"
# PADDOCK_OPENPILOT_DESIRE = "turn"
# [models.openpilot.benchmarks.kitscenes.settings]
# command_source = "gt"
# front_camera = "base"
#
# AutoE2E on Bench2Drive at its own 10 Hz (docs/models/autoe2e.md, "On
# Bench2Drive"): the agent calls every 20 Hz tick, and this runs the model every
# 0.1 s and holds the plan on the tick between. Not the published 20 Hz protocol,
# so a run with it is valid: false. ~1.3 s of wall clock a tick on an A100.
# [models.autoe2e.benchmarks.bench2drive.env]
# AUTOE2E_REPLAN_S = "0.1"

# Drive-JEPA reads each camera at its own intrinsics by default ("native"), which
# is how every published drivejepa row was made. "openscene" crops each camera
# onto the 64 deg OpenScene lens the checkpoint trained on, as the devkit's own
# KITScenes loader does. Either way it is recorded under provenance.policy.
# [models.drivejepa.env]
# DRIVEJEPA_IMAGE_GEOMETRY = "native"   # or "openscene"
#
# Momentum-aware selection (the paper's section 3.5) is "off" by default, which
# is how every published drivejepa row was made: the node drives the raw argmax
# of the learned score. "on" hands each replan the plan the node chose ~0.5 s
# earlier, so the model's own calibrate_score runs before the argmax -- what
# upstream's evaluation loop does. It changes which proposal is driven in closed
# loop; an open-loop sequence resets first and is unaffected. Recorded under
# provenance.policy with how often a previous plan was actually fed.
# DRIVEJEPA_MOMENTUM = "off"            # or "on"

# ---------------------------------------------------------------------------
# [ingest] -- where results that predate paddock live on this machine.
#
# Only needed for `paddock ingest`. Absent sources are reported and skipped, so
# no site is expected to have all of them; the full key list is the docstring of
# src/paddock/results/legacy.py.
# ---------------------------------------------------------------------------
# [ingest]
#
# AlpaSim writes into a bucket named for the model, so a site has several roots
# rather than one. Name the run directories to publish rather than walking a
# root: everything under a root is not necessarily a row worth publishing.
# alpasim_runs walks one root instead, one run per directory under it -- only
# for a root that holds nothing but runs worth publishing.
# alpasim_runs = "/path/to/alpasim-runs"
# alpasim_run_dirs = [
#   "/path/to/runs/openpilot/openpilot_020_pilot10",
#   "/path/to/runs/baselines/cv_023_20hz_pilot10",
# ]
#
# A run that is known-bad is still ingested, marked valid:false with the reason,
# because deleting it loses the record that it happened. Keyed by directory name.
# [ingest.alpasim_invalid]
# some_run_dir = "actor never rendered; scored against an empty road"
#
# A sweep driven one scene per wizard invocation leaves one directory per scene
# -- which is how anything behind the referee proxy runs, since the container is
# torn down between scenes. Ingested individually those are runs of n=1 and the
# ten-scene mean that was actually measured is nowhere in the store. Listed here
# they become one run; the merge is refused if the directories disagree about the
# driver or the tick config, or if two of them hold the same scene.
# [ingest.alpasim_campaigns.legacy-my_campaign_20hz]
# dirs  = ["/path/to/runs/alpamayo/my_campaign_scene01", "..."]
# split = "public_2601"  # a sweep driven by explicit scene ids records no
#                        # test_suite_id; name the suite its scenes came from
# notes = ""      # required by the results store when valid = false
# valid = true
#
# Recorded Bench2Drive route results, pooled into one run per model (or per
# speed band). An ARRAY of tables -- double brackets -- one block per run.
# `runs` may be one root or a list; routes default to every route found under
# them. The run id is <label>-<route hash>-<config hash>, so two blocks that
# differ only in `model_env` do not overwrite each other.
# See src/paddock/results/ingest/bench2drive.py and docs/benchmarks/bench2drive.md.
# [[ingest.bench2drive]]
# model  = "drivejepa"
# runs   = "/path/to/paddock-runs/bench2drive/drivejepa"
# label  = "pooled50"
# routes = ["1711", "1852", "2802"]
# notes  = "24 routes from the 03-04 Sep campaign, 26 from the 09 Sep expansion"
#
# Environment overrides recorded in the run's config. The ingest reads what the
# source runs recorded; this is layered on top, for what they did not. For the
# constant-velocity baseline it is the only machine-readable statement of which
# speed band a row is -- without it five bands are indistinguishable.
# [ingest.bench2drive.model_env]
# PADDOCK_CV_SPEED_SOURCE = "fixed"
# PADDOCK_CV_SPEED_M_S = "6"
#
# The recording setup each route was driven under, if they differ. Lands on the
# samples as `group`, so metrics.json carries a per-setup breakdown in
# `by_group`. A run pooling more than one setup is written `valid: false`: its
# mean describes no configuration anybody drove, and the leaderboard lists it as
# excluded rather than ranking it.
# [ingest.bench2drive.setups]
# assisted    = ["1711", "2802"]
# unassisted  = ["1852"]
#
# The native-rate campaign (18-20 Sep 2026), as it was actually ingested. It is
# the same 50 routes as the pooled50 blocks above with one knob turned: each model
# drove at the rate it replans at, set with PADDOCK_INFER_HZ. That rate is not read
# from model.yaml -- drivejepa declares none, and qwendrive's native_input_hz is
# its ego-pose history, not a planning rate -- so it is the operator's statement,
# and each run's notes say so.
# Two things in here are load-bearing, and both have bitten before:
#
#   * PADDOCK_INFER_HZ must be in `model_env`, because it is the only place the
#     rate is recorded at all: the harness did not write it into the source runs'
#     run_config.json. (The run ids would not collide without it -- the label is
#     part of the id and `source_runs` is hashed into the config -- but the record
#     would then say nothing about what rate was driven, which is the one thing
#     this campaign varied.) The ingest marks such a run `valid: false`: a rate
#     other than the benchmark's 20 Hz is a different protocol, so it is kept and
#     not ranked against rows that were driven at 20 Hz.
#   * `routes` must list all 50 even for the models that could not score one of
#     them. Route 3800 never scored for alpamayo15 or qwendrive, and what it left
#     behind differs by attempt: an UNSCORABLE.txt marker, or -- for
#     qwendrive/20260918T091245-f19361 -- a results.json with an empty
#     _checkpoint, which is why that record gets routes_never_scored and
#     alpamayo15's does not. Either way there is no score, so with `routes` unset
#     the ingest cannot see the route at all: it would vanish from the record
#     instead of landing in n_failed with status "partial". A route that was
#     requested and never scored is evidence.
#
# See docs/benchmarks/bench2drive-native-rate.md.
# [[ingest.bench2drive]]
# model  = "drivejepa"
# runs   = "/path/to/paddock-runs/bench2drive-diagnostics/native-50/drivejepa"
# label  = "native50-2hz"
# routes = ["14194", "1711", "17752", "18305", "18311", "18356", "1852", "2050", "2084", "2086", "2201", "2273", "2286", "24211", "24224", "24240", "24252", "24333", "24795", "24816", "2509", "2534", "25378", "2539", "25857", "25863", "26956", "26990", "27018", "27515", "27529", "27582", "2790", "2802", "3307", "3364", "3373", "3378", "3380", "3410", "3564", "3572", "3575", "3749", "3800", "3813", "3936", "4183", "4468", "4669"]
