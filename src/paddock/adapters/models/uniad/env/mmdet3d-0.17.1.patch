diff --git a/mmdet3d/ops/_missing_ext.py b/mmdet3d/ops/_missing_ext.py
new file mode 100644
index 0000000..25d6174
--- /dev/null
+++ b/mmdet3d/ops/_missing_ext.py
@@ -0,0 +1,13 @@
+# uniad_vad patch: the PyPI sdist of mmdet3d 0.17.1 ships no *.cu/*.h sources for these
+# point-cloud / voxel ops, so they are not built. They are lidar-only and unused by
+# camera-only UniAD/VAD. Equivalent kernels exist in mmcv-full 1.7.2 (mmcv.ops.*).
+
+
+class MissingExt:
+    def __init__(self, name):
+        self._name = name
+
+    def __getattr__(self, attr):
+        raise RuntimeError(
+            f'mmdet3d op extension "{self._name}" was not built in the uniad_vad env '
+            f'(PyPI sdist lacks its CUDA sources); use the mmcv.ops equivalent instead.')
