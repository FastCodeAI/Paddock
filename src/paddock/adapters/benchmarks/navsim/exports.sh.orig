# Drive-JEPA / NAVSIM v2 environment.
# Usage:  source exports.sh
#
# Everything lives on /shakaal_hdd_1 rather than $HOME: the root filesystem has
# ~138G free, and the navtest camera blobs alone need far more than that.

NAVSIM_WORKSPACE="/shakaal_hdd_1/workspace/naren/navsim_workspace"

export NUPLAN_MAP_VERSION="nuplan-maps-v1.0"
export NUPLAN_MAPS_ROOT="${NAVSIM_WORKSPACE}/dataset/maps"
export NAVSIM_EXP_ROOT="${NAVSIM_WORKSPACE}/exp"
export OPENSCENE_DATA_ROOT="${NAVSIM_WORKSPACE}/dataset"

# Point at the v2 devkit inside this repo (v1 lives alongside it in navsim_v1).
export NAVSIM_DEVKIT_ROOT="/shakaal_hdd_1/workspace/naren/renesas/Drive-JEPA/navsim_v2"
